{
  "name": "frontier-models-in-the-wild",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/models-in-the-wild/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reveal.js": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
